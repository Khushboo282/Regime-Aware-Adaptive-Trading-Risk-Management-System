
# Ignore datasets and generated data
data/raw/*
data/processed/*
data/interim/*

# Keep folder structure visible
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/interim/.gitkeep

# Python environment and generated files
__pycache__/
*.pyc
.venv/
venv/
.env

# Editor and OS files
.ipynb_checkpoints/
.vscode/
.DS_Store

# Compressed datasets
*.zip
